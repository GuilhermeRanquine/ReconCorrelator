          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    setIsExecuting(true);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    try {"
