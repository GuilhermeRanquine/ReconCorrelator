    instruction: "Fix set-state-in-effect in ReconFlowchart"
    replacement_infos {
      original_chunk {
        target_content: "export function ReconFlowchart({ target, onExecuteAutomation, discoveredCount = 0 }: ReconFlowchartProps) {\n  const [playbook, setPlaybook] = useState<ReconPlaybook>(() => ReconPlaybookGenerator.generateForTarget(target));\n  const [selectedStepId, setSelectedStepId] = useState<string>(playbook.steps[0].id);\n  const [copiedIndex, setCopiedIndex] = useState<string | null>(null);\n\n  // Update playbook if target domain changes\n  React.useEffect(() => {\n    setPlaybook(ReconPlaybookGenerator.generateForTarget(target));\n    setSelectedStepId(ReconPlaybookGenerator.generateForTarget(target).steps[0].id);\n  }, [target.id, target.domain]);\n\n  const selectedStep = playbook.steps.find(s => s.id === selectedStepId) || playbook.steps[0];\n\n  const handleToggleStatus = (stepId: string, newStatus: ReconFlowStep[\'status\']) => {\n    setPlaybook(prev => {\n      const updatedSteps = prev.steps.map(s => s.id === stepId ? { ...s, status: newStatus } : s);\n      const completedCount = updatedSteps.filter(s => s.status === \'completed\').length;\n      const progress = Math.round((completedCount / updatedSteps.length) * 100);\n      return {\n        ...prev,\n        steps: updatedSteps,\n        overallProgress: progress,\n        lastUpdated: new Date().toISOString(),\n      };\n    });\n  };\n\n  const copyToClipboard = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedIndex(id);\n    setTimeout(() => setCopiedIndex(null), 2000);\n  };\n\n  const completedSteps = playbook.steps.filter(s => s.status === \'completed\').length;\n  const progressPercent = Math.round((completedSteps / playbook.steps.length) * 100);"
        replacement_content: "export function ReconFlowchart({ target, onExecuteAutomation, discoveredCount = 0 }: ReconFlowchartProps) {\n  // Maintain custom step statuses per target\n  const [stepStatusOverrides, setStepStatusOverrides] = useState<Record<string, ReconFlowStep[\'status\']>>({});\n  const [selectedStepId, setSelectedStepId] = useState<string | null>(null);\n  const [copiedIndex, setCopiedIndex] = useState<string | null>(null);\n\n  const basePlaybook = React.useMemo(() => ReconPlaybookGenerator.generateForTarget(target), [target]);\n\n  const stepsWithStatus = React.useMemo(() => {\n    return basePlaybook.steps.map(step => ({\n      ...step,\n      status: stepStatusOverrides[step.id] || step.status,\n    }));\n  }, [basePlaybook, stepStatusOverrides]);\n\n  const activeStepId = selectedStepId || stepsWithStatus[0]?.id;\n  const selectedStep = stepsWithStatus.find(s => s.id === activeStepId) || stepsWithStatus[0];\n\n  const handleToggleStatus = (stepId: string, newStatus: ReconFlowStep[\'status\']) => {\n    setStepStatusOverrides(prev => ({\n      ...prev,\n      [stepId]: newStatus,\n    }));\n  };\n\n  const copyToClipboard = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedIndex(id);\n    setTimeout(() => setCopiedIndex(null), 2000);\n  };\n\n  const completedSteps = stepsWithStatus.filter(s => s.status === \'completed\').length;\n  const progressPercent = Math.round((completedSteps / stepsWithStatus.length) * 100);"
      }
      num_matches: 1
    }
  }
}
