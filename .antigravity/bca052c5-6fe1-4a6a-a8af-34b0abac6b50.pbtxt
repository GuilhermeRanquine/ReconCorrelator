          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                          isSelected ? \'bg-zinc-900 border-l-2 border-l-cyan-400\' : \'\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
