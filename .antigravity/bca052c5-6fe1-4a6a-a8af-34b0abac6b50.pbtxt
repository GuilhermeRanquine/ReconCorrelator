      replacement_content: "  const handleImportRawDataFromDrive = (rawText: string) => {\n    try {\n      const parsed = JSON.parse(rawText);\n      if (parsed.assets && Array.isArray(parsed.assets)) {\n        setAssets(parsed.assets);\n        if (parsed.target) {\n          setCurrentProject(parsed.target);\n        }\n        setActiveTab(\'assets\');\n        return;\n      }\n    } catch {\n      // Not JSON, treat as text list of subdomains\n      const lines = rawText.split(\'\\n\').map(l => l.trim()).filter(l => l && !l.startsWith(\'#\'));\n      const subdomains = lines.map(l => l.replace(/^(https?:\\/\\/)?/, \'\').split(\'/\')[0].split(\':\')[0]);\n      handleAssetsDiscovered(subdomains.map(s => ({ subdomain: s, rootDomain: currentProject.domain })));\n      setActiveTab(\'assets\');\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-black text-zinc-100 flex flex-col font-sans selection:bg-emerald-500/30 selection:text-emerald-300\">\n      <Header\n        currentProject={currentProject}\n        projects={projects}\n        onSelectProject={setCurrentProject}\n        onOpenIngestion={() => setIsIngestionOpen(true)}\n        onOpenProgramIngestion={() => setIsProgramIngestionOpen(true)}\n        onOpenScope={() => setIsScopeOpen(true)}\n        onOpenTdd={() => setActiveTab(\'tdd\')}\n        onOpenAiTriage={() => setIsAiTriageOpen(true)}\n        onOpenExport={() => setIsExportOpen(true)}\n        onNewScan={handleClearWorkspace}\n        totalAssets={totalAssets}\n        aliveCount={aliveCount}\n        vulnCount={vulnCount}\n        takeoverCount={takeoverCount}\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        researcherHandle=\"w0rmingstar\"\n      />\n\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 py-6 space-y-6\">\n        {/* Tab 0: Dashboard */}\n        {activeTab === \'dashboard\' && ("
    }
    instruction: "Add Google Drive tab render and import handler to page.tsx"
  }
}
