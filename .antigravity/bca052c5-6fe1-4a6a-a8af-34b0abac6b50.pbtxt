        }
        lines {
          text: "                textColor = \'#34d399\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              } else if (node.type === \'subdomain\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                radius = 20;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                if (node.severity === \'critical\' || node.severity === \'high\') {"
