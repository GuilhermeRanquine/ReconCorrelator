          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    </td>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  </tr>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                ) : ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  filteredAssets.map((asset) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    const isSelected = selectedAsset?.id === asset.id;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    const maxSev = asset.vulnerabilities.find(v => v.severity === \'critical\')"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      ? \'critical\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      : asset.vulnerabilities.find(v => v.severity === \'high\')"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      ? \'high\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      : asset.vulnerabilities.find(v => v.severity === \'medium\')"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      ? \'medium\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      : asset.vulnerabilities.length > 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      ? \'low\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      : null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    return ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
