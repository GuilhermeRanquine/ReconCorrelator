        }
        lines {
          text: "            </radialGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <radialGradient id=\"vulnGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"0%\" stopColor=\"#ef4444\" stopOpacity=\"0.6\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"100%\" stopColor=\"#ef4444\" stopOpacity=\"0\" />"
