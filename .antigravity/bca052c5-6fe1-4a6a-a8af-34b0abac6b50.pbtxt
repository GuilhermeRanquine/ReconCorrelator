        }
        lines {
          text: "            </radialGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <radialGradient id=\"nodeDragGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"0%\" stopColor=\"#38bdf8\" stopOpacity=\"0.5\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"100%\" stopColor=\"#38bdf8\" stopOpacity=\"0\" />"
