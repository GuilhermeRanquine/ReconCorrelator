        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      {/* Interactive SVG Canvas */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <div "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ref={containerRef}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        onWheel={handleWheel}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        onMouseDown={handleMouseDown}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        onMouseMove={handleMouseMove}"
