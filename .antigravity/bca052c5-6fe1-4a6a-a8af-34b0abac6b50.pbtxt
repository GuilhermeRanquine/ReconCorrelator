        }
        lines {
          text: "        onMouseUp={handleMouseUp}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        className=\"w-full h-full cursor-grab active:cursor-grabbing overflow-hidden bg-radial from-zinc-900/40 via-zinc-950 to-zinc-950\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        className={`w-full h-full overflow-hidden bg-radial from-zinc-900/40 via-zinc-950 to-zinc-950 ${"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          draggedNodeId ? \'cursor-grabbing\' : isCanvasPanning ? \'cursor-grabbing\' : \'cursor-grab\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }`}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <svg"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          ref={svgRef}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          className=\"w-full h-full\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          viewBox=\"0 0 1000 700\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          viewBox=\"0 0 1200 800\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          preserveAspectRatio=\"xMidYMid meet\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <defs>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <radialGradient id=\"rootGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"0%\" stopColor=\"#10b981\" stopOpacity=\"0.4\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"100%\" stopColor=\"#10b981\" stopOpacity=\"0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </radialGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <radialGradient id=\"vulnGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"0%\" stopColor=\"#ef4444\" stopOpacity=\"0.6\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"100%\" stopColor=\"#ef4444\" stopOpacity=\"0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </radialGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <radialGradient id=\"nodeDragGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <stop offset=\"0%\" stopColor=\"#38bdf8\" stopOpacity=\"0.5\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <stop offset=\"100%\" stopColor=\"#38bdf8\" stopOpacity=\"0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            </radialGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          </defs>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <g transform={`translate(${pan.x}, ${pan.y}) scale(${zoom})`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            {/* Background Subtle Grid */}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <pattern id=\"graphGrid\" width=\"60\" height=\"60\" patternUnits=\"userSpaceOnUse\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <path d=\"M 60 0 L 0 0 0 60\" fill=\"none\" stroke=\"#27272a\" strokeWidth=\"0.5\" strokeOpacity=\"0.4\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            </pattern>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <rect x=\"-3000\" y=\"-3000\" width=\"8000\" height=\"8000\" fill=\"url(#graphGrid)\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            {/* Edges */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            {graphData.edges.map((edge) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const sourcePos = positionedNodes[edge.source];"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              const targetPos = positionedNodes[edge.target];"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              const sourcePos = finalPositions[edge.source];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              const targetPos = finalPositions[edge.target];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              if (!sourcePos || !targetPos) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const isVulnEdge = edge.type === \'vulnerable_to\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const isHighlight = selectedNode && (selectedNode.id === edge.source || selectedNode.id === edge.target);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              return ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <g key={edge.id}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <line"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    x1={sourcePos.x}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    y1={sourcePos.y}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    x2={targetPos.x}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    y2={targetPos.y}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    stroke={isVulnEdge ? \'#ef4444\' : \'#27272a\'}"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                    strokeWidth={isVulnEdge ? 1.5 : 1}"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                    strokeDasharray={isVulnEdge ? \'3,3\' : undefined}"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                    className=\"transition-colors\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                    stroke={isHighlight ? \'#38bdf8\' : isVulnEdge ? \'#ef4444\' : \'#27272a\'}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    strokeWidth={isHighlight ? 2.5 : isVulnEdge ? 1.5 : 1}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    strokeDasharray={isVulnEdge ? \'4,4\' : undefined}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    strokeOpacity={isHighlight ? 1 : 0.7}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  {edge.label && ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <text"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      x={(sourcePos.x + targetPos.x) / 2}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      y={(sourcePos.y + targetPos.y) / 2 - 4}"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                      fill=\"#ef4444\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                      y={(sourcePos.y + targetPos.y) / 2 - 5}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      fill={isVulnEdge ? \'#ef4444\' : \'#71717a\'}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      fontSize=\"9\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      fontFamily=\"monospace\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      textAnchor=\"middle\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      className=\"select-none\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                      className=\"select-none pointer-events-none\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
