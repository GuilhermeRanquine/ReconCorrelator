        }
        lines {
          text: "        onMouseUp={handleMouseUp}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        style={{ overscrollBehavior: \'contain\', touchAction: \'none\' }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        className={`w-full h-full overflow-hidden bg-radial from-zinc-900/40 via-zinc-950 to-zinc-950 select-none ${"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          draggedNodeId ? \'cursor-grabbing\' : isCanvasPanning ? \'cursor-grabbing\' : \'cursor-grab\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }`}"
