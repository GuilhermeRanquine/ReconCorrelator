          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          viewBox=\"0 0 1200 800\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          preserveAspectRatio=\"xMidYMid meet\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
