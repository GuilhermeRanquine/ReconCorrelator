          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <defs>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <radialGradient id=\"rootGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <stop offset=\"0%\" stopColor=\"#10b981\" stopOpacity=\"0.4\" />"
