          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                              asset.httpStatus >= 200 && asset.httpStatus < 300 ? \'bg-emerald-950 text-emerald-400 border border-emerald-800\' :"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                              asset.httpStatus >= 300 && asset.httpStatus < 400 ? \'bg-cyan-950 text-cyan-400 border border-cyan-800\' :"
