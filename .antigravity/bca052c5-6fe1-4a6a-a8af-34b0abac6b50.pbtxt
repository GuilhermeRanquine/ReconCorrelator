  file_change {
    absolute_path_uri: "file:///components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "interface HeaderProps {\n  currentProject: TargetProject;\n  projects: TargetProject[];\n  onSelectProject: (project: TargetProject) => void;\n  onOpenIngestion: () => void;\n  onOpenScope: () => void;\n  onOpenTdd: () => void;\n  onOpenAiTriage: () => void;\n  onOpenExport: () => void;\n  onNewScan: () => void;\n  totalAssets: number;\n  aliveCount: number;\n  vulnCount: number;\n  takeoverCount: number;\n  activeTab: \'dashboard\' | \'graph\' | \'assets\' | \'pipeline\' | \'tdd\';\n  setActiveTab: (tab: \'dashboard\' | \'graph\' | \'assets\' | \'pipeline\' | \'tdd\') => void;\n}\n\nexport function Header({\n  currentProject,\n  projects,\n  onSelectProject,\n  onOpenIngestion,\n  onOpenScope,\n  onOpenTdd,\n  onOpenAiTriage,\n  onOpenExport,\n  onNewScan,\n  totalAssets,\n  aliveCount,\n  vulnCount,\n  takeoverCount,\n  activeTab,\n  setActiveTab,\n}: HeaderProps) {\n  return (\n    <header className=\"border-b border-zinc-800 bg-zinc-950/90 backdrop-blur-md sticky top-0 z-40\">\n      {/* Top Squad & Target Bar */}\n      <div className=\"max-w-7xl mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 border-b border-zinc-800/60\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400\">\n              <Terminal className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-mono font-bold text-sm text-zinc-100 tracking-wide\">RECON_CORRELATOR</span>\n                <span className=\"text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/60\">\n                  v3.4-RedTeam\n                </span>\n              </div>\n              <p className=\"text-[11px] text-zinc-400 font-mono\">Orquestrador de Superf\303\255cie & Triagem</p>\n            </div>\n          </div>\n\n          <div className=\"hidden lg:flex items-center pl-4 border-l border-zinc-800 gap-1 text-[11px] font-mono\">\n            {/* Squad Status Badges */}\n            <div className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-300\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse\"></span>\n              <strong className=\"text-red-400\">ALPHA:</strong> RedTeam Lead\n            </div>\n            <div className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-300\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-cyan-400\"></span>\n              <strong className=\"text-cyan-400\">BETA:</strong> Async Engine\n            </div>\n            <div className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-300\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-purple-400\"></span>\n              <strong className=\"text-purple-400\">GAMMA:</strong> Dark UI\n            </div>\n            <button \n              onClick={onOpenTdd}\n              className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/80 text-emerald-300 hover:bg-emerald-900/60 transition-colors cursor-pointer\"\n              title=\"Abrir Centro de Testes TDD do DELTA\"\n            >\n              <CheckCircle2 className=\"w-3 h-3 text-emerald-400\" />\n              <strong className=\"text-emerald-400\">DELTA:</strong> TDD Enforcer (100% Passed)\n            </button>\n          </div>\n        </div>\n\n        {/* Target Selector & OPSEC Indicator */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"flex items-center gap-1.5 bg-zinc-900 border border-zinc-800 rounded-md px-2.5 py-1 text-xs\">\n            <Radio className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n            <span className=\"text-zinc-400 text-[11px] font-mono\">TARGET:</span>\n            <select\n              className=\"bg-transparent text-zinc-100 font-mono text-xs focus:outline-none cursor-pointer\"\n              value={currentProject.id}\n              onChange={(e) => {\n                const found = projects.find(p => p.id === e.target.value);\n                if (found) onSelectProject(found);\n              }}\n            >\n              {projects.map((p) => (\n                <option key={p.id} value={p.id} className=\"bg-zinc-900 text-zinc-100\">\n                  {p.domain} ({p.name.substring(0, 20)}...)\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <button\n            onClick={onOpenScope}\n            className=\"flex items-center gap-1 px-2.5 py-1 bg-amber-950/40 hover:bg-amber-900/50 border border-amber-800/60 rounded-md text-amber-300 text-xs font-mono transition-colors cursor-pointer\"\n            title=\"Gerenciar Regras de Escopo (In-Scope / Out-of-Scope)\"\n          >\n            <ShieldAlert className=\"w-3.5 h-3.5\" />\n            <span>OPSEC Guard</span>\n          </button>\n\n          <button\n            onClick={onOpenAiTriage}\n            className=\"flex items-center gap-1 px-2.5 py-1 bg-purple-950/50 hover:bg-purple-900/60 border border-purple-700/60 rounded-md text-purple-200 text-xs font-mono transition-colors shadow-sm cursor-pointer\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-purple-400\" />\n            <span>AI Triage</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Navigation and Metric Strip */}\n      <div className=\"max-w-7xl mx-auto px-4 py-2 flex flex-wrap items-center justify-between gap-4\">\n        {/* Navigation Tabs */}\n        <nav className=\"flex items-center gap-1 font-mono text-xs\">\n          <button\n            onClick={() => setActiveTab(\'dashboard\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all ${\n              activeTab === \'dashboard\'\n                ? \'bg-zinc-800 text-zinc-100 font-medium shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Activity className=\"w-3.5 h-3.5 text-emerald-400\" />\n            Vis\303\243o Geral\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'graph\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all ${\n              activeTab === \'graph\'\n                ? \'bg-zinc-800 text-zinc-100 font-medium shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Cpu className=\"w-3.5 h-3.5 text-cyan-400\" />\n            Grafo de Ataque\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'assets\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all ${\n              activeTab === \'assets\'\n                ? \'bg-zinc-800 text-zinc-100 font-medium shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Database className=\"w-3.5 h-3.5 text-amber-400\" />\n            Matriz de Ativos ({totalAssets})\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'pipeline\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all ${\n              activeTab === \'pipeline\'\n                ? \'bg-zinc-800 text-zinc-100 font-medium shadow-sm\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Terminal className=\"w-3.5 h-3.5 text-emerald-400\" />\n            Orquestrador CLI\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'tdd\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all ${\n              activeTab === \'tdd\'\n                ? \'bg-emerald-950/70 border border-emerald-700/80 text-emerald-300 font-medium\'\n                : \'text-emerald-400 hover:bg-emerald-950/30\'\n            }`}\n          >\n            <FileCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            TDD Suite (Delta)\n          </button>\n        </nav>"
      replacement_content: "export type ReconTab = \'dashboard\' | \'flowchart\' | \'workbench\' | \'graph\' | \'assets\' | \'pipeline\' | \'tdd\';\n\ninterface HeaderProps {\n  currentProject: TargetProject;\n  projects: TargetProject[];\n  onSelectProject: (project: TargetProject) => void;\n  onOpenIngestion: () => void;\n  onOpenProgramIngestion: () => void;\n  onOpenScope: () => void;\n  onOpenTdd: () => void;\n  onOpenAiTriage: () => void;\n  onOpenExport: () => void;\n  onNewScan: () => void;\n  totalAssets: number;\n  aliveCount: number;\n  vulnCount: number;\n  takeoverCount: number;\n  activeTab: ReconTab;\n  setActiveTab: (tab: ReconTab) => void;\n}\n\nexport function Header({\n  currentProject,\n  projects,\n  onSelectProject,\n  onOpenIngestion,\n  onOpenProgramIngestion,\n  onOpenScope,\n  onOpenTdd,\n  onOpenAiTriage,\n  onOpenExport,\n  onNewScan,\n  totalAssets,\n  aliveCount,\n  vulnCount,\n  takeoverCount,\n  activeTab,\n  setActiveTab,\n}: HeaderProps) {\n  return (\n    <header className=\"border-b border-zinc-800 bg-zinc-950/90 backdrop-blur-md sticky top-0 z-40\">\n      {/* Top Squad & Target Bar */}\n      <div className=\"max-w-7xl mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 border-b border-zinc-800/60\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400\">\n              <Terminal className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-mono font-bold text-sm text-zinc-100 tracking-wide\">RECON_CORRELATOR</span>\n                <span className=\"text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/60\">\n                  v3.4-RedTeam\n                </span>\n              </div>\n              <p className=\"text-[11px] text-zinc-400 font-mono\">Orquestrador de Superf\303\255cie & Triagem</p>\n            </div>\n          </div>\n\n          <div className=\"hidden lg:flex items-center pl-4 border-l border-zinc-800 gap-1 text-[11px] font-mono\">\n            {/* Squad Status Badges */}\n            <div className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-300\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse\"></span>\n              <strong className=\"text-red-400\">ALPHA:</strong> RedTeam\n            </div>\n            <div className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-300\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-cyan-400\"></span>\n              <strong className=\"text-cyan-400\">BETA:</strong> Async Engine\n            </div>\n            <div className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-300\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-purple-400\"></span>\n              <strong className=\"text-purple-400\">GAMMA:</strong> Dark UI\n            </div>\n            <button \n              onClick={onOpenTdd}\n              className=\"flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/80 text-emerald-300 hover:bg-emerald-900/60 transition-colors cursor-pointer\"\n              title=\"Abrir Centro de Testes TDD do DELTA\"\n            >\n              <CheckCircle2 className=\"w-3 h-3 text-emerald-400\" />\n              <strong className=\"text-emerald-400\">DELTA:</strong> TDD (100%)\n            </button>\n          </div>\n        </div>\n\n        {/* Target Selector & OPSEC Indicator */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={onOpenProgramIngestion}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-black font-bold rounded-lg text-xs font-mono transition-all shadow-lg hover:shadow-emerald-950/50 cursor-pointer\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Link BugBounty / Novo Alvo</span>\n          </button>\n\n          <div className=\"flex items-center gap-1.5 bg-zinc-900 border border-zinc-800 rounded-md px-2.5 py-1 text-xs\">\n            <Radio className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n            <span className=\"text-zinc-400 text-[11px] font-mono\">TARGET:</span>\n            <select\n              className=\"bg-transparent text-zinc-100 font-mono text-xs focus:outline-none cursor-pointer max-w-[160px] truncate\"\n              value={currentProject.id}\n              onChange={(e) => {\n                const found = projects.find(p => p.id === e.target.value);\n                if (found) onSelectProject(found);\n              }}\n            >\n              {projects.map((p) => (\n                <option key={p.id} value={p.id} className=\"bg-zinc-900 text-zinc-100\">\n                  {p.domain}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <button\n            onClick={onOpenScope}\n            className=\"flex items-center gap-1 px-2.5 py-1 bg-amber-950/40 hover:bg-amber-900/50 border border-amber-800/60 rounded-md text-amber-300 text-xs font-mono transition-colors cursor-pointer\"\n            title=\"Gerenciar Regras de Escopo (In-Scope / Out-of-Scope)\"\n          >\n            <ShieldAlert className=\"w-3.5 h-3.5\" />\n            <span>Scope Guard</span>\n          </button>\n\n          <button\n            onClick={onOpenAiTriage}\n            className=\"flex items-center gap-1 px-2.5 py-1 bg-purple-950/50 hover:bg-purple-900/60 border border-purple-700/60 rounded-md text-purple-200 text-xs font-mono transition-colors shadow-sm cursor-pointer\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-purple-400\" />\n            <span>AI Triage</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Navigation and Metric Strip */}\n      <div className=\"max-w-7xl mx-auto px-4 py-2 flex flex-wrap items-center justify-between gap-4\">\n        {/* Navigation Tabs */}\n        <nav className=\"flex items-center gap-1 font-mono text-xs overflow-x-auto py-0.5\">\n          <button\n            onClick={() => setActiveTab(\'dashboard\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all whitespace-nowrap ${\n              activeTab === \'dashboard\'\n                ? \'bg-zinc-800 text-zinc-100 font-medium shadow-sm ring-1 ring-zinc-700\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Activity className=\"w-3.5 h-3.5 text-emerald-400\" />\n            Vis\303\243o Geral\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'flowchart\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all whitespace-nowrap ${\n              activeTab === \'flowchart\'\n                ? \'bg-zinc-800 text-emerald-300 font-medium shadow-sm ring-1 ring-emerald-500/50\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <GitBranch className=\"w-3.5 h-3.5 text-emerald-400\" />\n            Fluxograma & Playbook\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'workbench\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all whitespace-nowrap ${\n              activeTab === \'workbench\'\n                ? \'bg-zinc-800 text-cyan-300 font-medium shadow-sm ring-1 ring-cyan-500/50\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Radio className=\"w-3.5 h-3.5 text-cyan-400\" />\n            Workbench Ao Vivo\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'graph\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all whitespace-nowrap ${\n              activeTab === \'graph\'\n                ? \'bg-zinc-800 text-zinc-100 font-medium shadow-sm ring-1 ring-zinc-700\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Cpu className=\"w-3.5 h-3.5 text-purple-400\" />\n            Grafo de Ataque\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'assets\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all whitespace-nowrap ${\n              activeTab === \'assets\'\n                ? \'bg-zinc-800 text-zinc-100 font-medium shadow-sm ring-1 ring-zinc-700\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Database className=\"w-3.5 h-3.5 text-amber-400\" />\n            Ativos ({totalAssets})\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'pipeline\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all whitespace-nowrap ${\n              activeTab === \'pipeline\'\n                ? \'bg-zinc-800 text-zinc-100 font-medium shadow-sm ring-1 ring-zinc-700\'\n                : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n            }`}\n          >\n            <Terminal className=\"w-3.5 h-3.5 text-emerald-400\" />\n            Orquestrador CLI\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'tdd\')}\n            className={`px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-all whitespace-nowrap ${\n              activeTab === \'tdd\'\n                ? \'bg-emerald-950/70 border border-emerald-700/80 text-emerald-300 font-medium\'\n                : \'text-emerald-400 hover:bg-emerald-950/30\'\n            }`}\n          >\n            <FileCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            TDD Suite\n          </button>\n        </nav>\n\n        {/* Quick Operational Metrics */}\n        <div className=\"flex items-center gap-2 font-mono text-xs\">\n          <div className=\"px-2.5 py-1 bg-zinc-900 border border-zinc-800 rounded-md text-zinc-300\">\n            <span className=\"text-zinc-500\">Vivos:</span> <strong className=\"text-emerald-400\">{aliveCount}</strong>/{totalAssets}\n          </div>\n\n          <div className=\"px-2.5 py-1 bg-zinc-900 border border-zinc-800 rounded-md text-zinc-300\">\n            <span className=\"text-zinc-500\">Vulns:</span> <strong className={vulnCount > 0 ? \'text-red-400\' : \'text-zinc-300\'}>{vulnCount}</strong>\n          </div>\n\n          {takeoverCount > 0 && (\n            <div className=\"px-2.5 py-1 bg-red-950/60 border border-red-800/80 rounded-md text-red-300 animate-pulse\">\n              <span>Takeovers:</span> <strong>{takeoverCount}</strong>\n            </div>\n          )}\n\n          {/* Action Buttons */}\n          <div className=\"flex items-center gap-1.5 pl-2 border-l border-zinc-800\">\n            <button\n              onClick={onOpenIngestion}\n              className=\"flex items-center gap-1 px-2.5 py-1.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-md text-zinc-200 text-xs font-mono transition-colors cursor-pointer\"\n              title=\"Ingerir dados de ferramentas (Subfinder, Httpx, Nmap, Nuclei)\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              <span>Importar RAW</span>\n            </button>\n\n            <button\n              onClick={onOpenExport}\n              className=\"p-1.5 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-md text-zinc-300 transition-colors cursor-pointer\"\n              title=\"Exportar Relat\303\263rio e Superf\303\255cie\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n}"
    }
